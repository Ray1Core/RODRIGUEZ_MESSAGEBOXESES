@model RODRIGUEZ_MESSAGEBOXE.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="auth-shell auth-register">

    <!-- Brand panel -->
    <div class="auth-brand">
        <a asp-controller="Home" asp-action="Index" class="auth-back-btn">
            <i class="fas fa-arrow-left"></i> Back
        </a>
        <a class="auth-brand-mark" asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus"></i> RODRIGUEZ_MESSAGEBOXE
        </a>
        <h1 class="auth-brand-heading">Create Account</h1>
        <p class="auth-brand-text">Sign up to get started &mdash; it only takes a minute.</p>
        <p class="auth-brand-foot">&copy; RODRIGUEZ_MESSAGEBOXE 2026</p>
    </div>

    <!-- Form panel -->
    <div class="auth-form-panel">
        <div class="auth-card">

            <h2 class="auth-card-title">Sign Up</h2>
            <p class="auth-card-subtitle">Fill in your details to create your account.</p>

            <!-- jQuery output: populated after the AJAX register request completes.
                 Rendered as a centered overlay so the full message + details are
                 always visible, regardless of scroll position. -->
            <div id="registerOutputBackdrop" class="js-alert-backdrop">
                <div id="registerOutput" class="alert d-none alert-center-modal" role="alert"></div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" novalidate>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Juan Dela Cruz" autocomplete="name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold"></label>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold d-block">Gender</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Gender" id="genderMale" value="Male" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Gender" id="genderFemale" value="Female" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Gender" id="genderOther" value="Other" />
                                    <label class="form-check-label" for="genderOther">Other</label>
                                </div>
                                <div>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Age" class="form-label fw-bold"></label>
                                    <input asp-for="Age" type="number" min="1" max="120" class="form-control" placeholder="18" value="" />
                                    <span asp-validation-for="Age" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Username" class="form-label fw-bold"></label>
                                    <input asp-for="Username" class="form-control" placeholder="juandelacruz" autocomplete="username" />
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label fw-bold"></label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="House No., Street, Barangay, City"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label fw-bold"></label>
                                    <input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <p class="small text-muted">
                                <i class="fas fa-lock me-1"></i>
                                Your password is combined with a unique random salt and hashed before it is ever saved â€” we never store or see your plain-text password.
                            </p>

                            <div class="d-grid mt-4">
                                <button id="registerSubmitBtn" type="submit" class="btn btn-primary btn-lg text-uppercase">Register</button>
                            </div>

                            <p class="text-center mt-4 mb-0">
                                Already have an account? <a class="auth-switch-link" asp-controller="Account" asp-action="Login">Sign in</a>
                            </p>
                        </form>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" crossorigin="anonymous"></script>

    <script>
        $(function () {
            var $form = $("#registerForm");
            var $output = $("#registerOutput");
            var $backdrop = $("#registerOutputBackdrop");
            var $submitBtn = $("#registerSubmitBtn");
            var originalBtnText = $submitBtn.text();

            function showOutput(message, type) {
                // type: "success" or "danger"
                $output
                    .removeClass("d-none alert-success alert-danger")
                    .addClass("alert-" + type)
                    .html(message)
                    .hide();
                $backdrop.addClass("show");
                $output.fadeIn(200);
            }

            function hideOutput() {
                $backdrop.removeClass("show");
                $output.addClass("d-none");
            }

            // Let the user dismiss an error alert by clicking outside the box.
            $backdrop.on("click", function (e) {
                if (e.target === this && $output.hasClass("alert-danger")) {
                    hideOutput();
                }
            });

            function clearFieldErrors() {
                $form.find(".text-danger").each(function () {
                    if ($(this).is("span")) {
                        $(this).text("");
                    }
                });
                $form.find(".is-invalid").removeClass("is-invalid");
            }

            function applyFieldErrors(errors) {
                clearFieldErrors();
                $.each(errors, function (fieldName, messages) {
                    var $field = $form.find("[name='" + fieldName + "']");
                    var $span = $form.find("span[data-valmsg-for='" + fieldName + "']");
                    if ($span.length) {
                        $span.text(messages[0]);
                    }
                    $field.addClass("is-invalid");
                });
            }

            $form.on("submit", function (e) {
                e.preventDefault();

                // Run the existing jQuery Validate rules first; do nothing if the form is invalid.
                if ($form.data("validator") && !$form.valid()) {
                    return;
                }

                hideOutput();
                $submitBtn.prop("disabled", true).text("Creating account...");

                $.ajax({
                    url: $form.attr("action") || window.location.href,
                    method: "POST",
                    data: $form.serialize(),
                    dataType: "json"
                })
                    .done(function (response) {
                        if (response.success) {
                            clearFieldErrors();
                            var username = $form.find('[name="Username"]').val();
                            var password = $form.find('[name="Password"]').val();
                            $form[0].reset();
                            $submitBtn.prop("disabled", false).text(originalBtnText);
                            showOutput(
                                "<i class='fas fa-check-circle me-1'></i><strong>Account created! You can now log in.</strong>" +
                                "<div class='mt-2 small'>" +
                                "<div><strong>Username:</strong> " + username + "</div>" +
                                "<div><strong>Password:</strong> " + password + "</div>" +
                                "</div>" +
                                "<div class='mt-2'><a href='/Account/Login'>Sign in now</a></div>",
                                "success"
                            );
                        } else {
                            applyFieldErrors(response.errors || {});
                            // Collect all field-level error messages to show alongside the generic prompt
                            var allErrors = [];
                            if (response.errors) {
                                $.each(response.errors, function (field, msgs) {
                                    if (msgs && msgs.length) allErrors.push(msgs[0]);
                                });
                            }
                            var errorDetail = allErrors.length
                                ? "<ul class='mb-0 mt-1 small'>" + allErrors.map(function(m){ return "<li>" + m + "</li>"; }).join("") + "</ul>"
                                : "";
                            showOutput(
                                "<i class='fas fa-exclamation-triangle me-1'></i><strong>Please fix the errors and try again.</strong>" + errorDetail,
                                "danger"
                            );
                            $submitBtn.prop("disabled", false).text(originalBtnText);
                        }
                    })
                    .fail(function () {
                        showOutput(
                            "<i class='fas fa-exclamation-triangle me-1'></i>Something went wrong while creating your account. Please try again.",
                            "danger"
                        );
                        $submitBtn.prop("disabled", false).text(originalBtnText);
                    });
            });
        });
    </script>
}
