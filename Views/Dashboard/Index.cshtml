@model List<RODRIGUEZ_MESSAGEBOXE.Models.User>
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-section" style="padding-top: 10rem;">
    <div class="container-fluid px-4">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Dashboard</h2>
        <div class="divider-custom">
            <div class="divider-custom-line"></div>
            <div class="divider-custom-icon"><i class="fas fa-database"></i></div>
            <div class="divider-custom-line"></div>
        </div>

        <div class="row">

            <!-- â”€â”€ FORM PANEL â”€â”€ -->
            <div class="col-lg-3 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white fw-bold text-uppercase" id="formTitle">
                        <i class="fas fa-plus-circle me-2"></i>Add User
                    </div>
                    <div class="card-body">

                        <div id="crudAlert" class="alert d-none mb-3" role="alert"></div>

                        <form id="crudForm">
                            <input type="hidden" id="mode" value="insert" />
                            <input type="hidden" id="editId" name="id" value="" />

                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Name</label>
                                <input type="text" id="fName" name="name" class="form-control form-control-sm" placeholder="Juan Dela Cruz" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Email</label>
                                <input type="email" id="fEmail" name="email" class="form-control form-control-sm" placeholder="name@example.com" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Username</label>
                                <input type="text" id="fUsername" name="username" class="form-control form-control-sm" placeholder="juandelacruz" />
                            </div>
                            <div class="mb-2" id="passwordField">
                                <label class="form-label fw-bold mb-1">Password</label>
                                <input type="password" id="fPassword" name="password" class="form-control form-control-sm" placeholder="Password" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Gender</label>
                                <select id="fGender" name="gender" class="form-select form-select-sm">
                                    <option value="">-- Select --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Age</label>
                                <input type="number" id="fAge" name="age" min="1" max="120" class="form-control form-control-sm" placeholder="18" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold mb-1">Address</label>
                                <textarea id="fAddress" name="address" class="form-control form-control-sm" rows="2" placeholder="House No., Street, Barangay, City"></textarea>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" id="submitBtn" class="btn btn-sm btn-primary">
                                    <i class="fas fa-save me-1"></i> Save
                                </button>
                                <button type="button" id="cancelBtn" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-times me-1"></i> Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- â”€â”€ TABLE PANEL â”€â”€ -->
            <div class="col-lg-9 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 text-uppercase text-secondary">Registered Users</h5>
                    <button id="refreshBtn" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-sync-alt me-1"></i> Refresh
                    </button>
                </div>

                <div id="tableWrap" class="table-responsive">
                    @if (Model != null && Model.Count > 0)
                    {
                        <table class="table table-bordered table-hover table-sm align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Username</th>
                                    <th>Gender</th>
                                    <th>Age</th>
                                    <th>Address</th>
                                    <th>Registered</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="userTbody">
                                @foreach (var u in Model)
                                {
                                    <tr>
                                        <td>@u.Id</td>
                                        <td>@u.Name</td>
                                        <td>@u.Email</td>
                                        <td>@u.Username</td>
                                        <td>@u.Gender</td>
                                        <td>@u.Age</td>
                                        <td>@u.Address</td>
                                        <td>@u.CreatedAtUtc.ToString("MMM d, yyyy")</td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning me-1 js-edit"
                                                    data-id="@u.Id"
                                                    data-name="@u.Name"
                                                    data-email="@u.Email"
                                                    data-username="@u.Username"
                                                    data-gender="@u.Gender"
                                                    data-age="@u.Age"
                                                    data-address="@u.Address">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-xs btn-danger js-delete" data-id="@u.Id">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-center text-muted" id="emptyMsg">No users yet. Register an account or add one using the form.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
<script>
$(function () {

    function showAlert(msg, isSuccess) {
        $('#crudAlert')
            .removeClass('alert-success alert-danger d-none')
            .addClass(isSuccess ? 'alert-success' : 'alert-danger')
            .text(msg)
            .stop(true, true).fadeIn().delay(3000).fadeOut();
    }

    function renderTable(users) {
        var $wrap = $('#tableWrap');
        if (!users || users.length === 0) {
            $wrap.html('<p class="text-center text-muted" id="emptyMsg">No users yet. Register an account or add one using the form.</p>');
            return;
        }

        if ($('#userTbody').length === 0) {
            $wrap.html(
                '<table class="table table-bordered table-hover table-sm align-middle">' +
                '<thead class="table-dark"><tr>' +
                '<th>ID</th><th>Name</th><th>Email</th><th>Username</th>' +
                '<th>Gender</th><th>Age</th><th>Address</th><th>Registered</th>' +
                '<th class="text-center">Actions</th>' +
                '</tr></thead><tbody id="userTbody"></tbody></table>'
            );
        }

        var rows = '';
        for (var i = 0; i < users.length; i++) {
            var u = users[i];
            rows += '<tr>' +
                '<td>' + u.id + '</td>' +
                '<td>' + u.name + '</td>' +
                '<td>' + u.email + '</td>' +
                '<td>' + u.username + '</td>' +
                '<td>' + (u.gender || '') + '</td>' +
                '<td>' + (u.age || '') + '</td>' +
                '<td>' + (u.address || '') + '</td>' +
                '<td>' + (u.createdAt || '') + '</td>' +
                '<td class="text-center">' +
                  '<button class="btn btn-xs btn-warning me-1 js-edit" ' +
                    'data-id="' + u.id + '" data-name="' + u.name + '" ' +
                    'data-email="' + u.email + '" data-username="' + u.username + '" ' +
                    'data-gender="' + (u.gender||'') + '" data-age="' + (u.age||'') + '" ' +
                    'data-address="' + (u.address||'') + '">' +
                    '<i class="fas fa-edit"></i>' +
                  '</button>' +
                  '<button class="btn btn-xs btn-danger js-delete" data-id="' + u.id + '">' +
                    '<i class="fas fa-trash-alt"></i>' +
                  '</button>' +
                '</td>' +
                '</tr>';
        }
        $('#userTbody').html(rows);
    }

    function resetForm() {
        $('#mode').val('insert');
        $('#editId').val('');
        $('#crudForm')[0].reset();
        $('#passwordField').show();
        $('#formTitle').html('<i class="fas fa-plus-circle me-2"></i>Add User');
        $('#submitBtn').removeClass('btn-warning').addClass('btn-primary').html('<i class="fas fa-save me-1"></i> Save');
    }

    // Insert or Update submit
    $('#crudForm').on('submit', function (e) {
        e.preventDefault();
        var mode = $('#mode').val();
        var url  = mode === 'update' ? '/Dashboard/Update' : '/Dashboard/Insert';

        $.ajax({ url: url, method: 'POST', data: $(this).serialize(), dataType: 'json' })
            .done(function (r) {
                if (!r.success) { showAlert(r.error, false); return; }
                showAlert(r.message, true);
                resetForm();
                renderTable(r.users);
            })
            .fail(function () { showAlert('Request failed. Please try again.', false); });
    });

    // Edit â€” populate form
    $(document).on('click', '.js-edit', function () {
        var $b = $(this);
        $('#mode').val('update');
        $('#editId').val($b.data('id'));
        $('#fName').val($b.data('name'));
        $('#fEmail').val($b.data('email'));
        $('#fUsername').val($b.data('username'));
        $('#fGender').val($b.data('gender'));
        $('#fAge').val($b.data('age'));
        $('#fAddress').val($b.data('address'));
        $('#passwordField').hide();   // password not required for update
        $('#formTitle').html('<i class="fas fa-edit me-2"></i>Edit User (ID ' + $b.data('id') + ')');
        $('#submitBtn').removeClass('btn-primary').addClass('btn-warning').html('<i class="fas fa-save me-1"></i> Update');
        $('html, body').animate({ scrollTop: 0 }, 300);
    });

    // Delete
    $(document).on('click', '.js-delete', function () {
        var id = $(this).data('id');
        if (!confirm('Delete user ID ' + id + '?')) return;
        $.ajax({ url: '/Dashboard/Delete', method: 'POST', data: { id: id }, dataType: 'json' })
            .done(function (r) {
                if (!r.success) { showAlert(r.error, false); return; }
                showAlert(r.message, true);
                renderTable(r.users);
            })
            .fail(function () { showAlert('Request failed.', false); });
    });

    // Cancel
    $('#cancelBtn').on('click', resetForm);

    // Refresh
    $('#refreshBtn').on('click', function () {
        $.get('/Dashboard/GetAll', function (r) { renderTable(r.users); });
    });

});
</script>
}
